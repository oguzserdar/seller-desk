# Seller Desk settings. Copy to .env.local (never commit it), or run `pnpm demo`
# to have a fixture setup written for you with fresh secrets.

# fixture: simulated PayPal for local demos and automated tests; no PayPal account, no real money.
# sandbox: PayPal sandbox (test money) and a real AI provider. Use a separate database per mode.
APP_MODE=fixture

# The public address of this app (scheme://host[:port], no path). Used for PayPal
# return links, the widget script and owner sign-in.
APP_URL=http://localhost:4310

# PostgreSQL for Node/Vercel. For Workers D1 use DATABASE_KIND=d1, remove
# DATABASE_URL, and configure the native DB binding. See docs/database-portability.md.
DATABASE_KIND=postgres
# PostgreSQL 15 or newer, connected directly (not through a query cache).
DATABASE_URL=postgresql://localhost:5432/seller_desk
# DATABASE_POOL_MAX=10

# Two different random values, 32+ characters each: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
JOBS_SECRET=
# New hosted installation only: a THIRD, different random value, 32+ characters.
# Enables the protected /owner/start form while the shop is empty. Remove after setup.
# INSTALL_TOKEN=
# BETTER_AUTH_URL=   (only if owner sign-in runs on another origin than APP_URL)

# Assistant: a real model is required; there is no stand-in. Without one the
# shop and desk work, and the assistant says it is not connected.
# gateway, openrouter, openai, anthropic or google:
AI_PROVIDER=gateway
AI_MODEL_ID=anthropic/claude-sonnet-5.5
AI_ROUTING_PROVIDER=gateway
AI_GATEWAY_API_KEY=
# Jev uses this same key. Routing is optional and independent of the reply provider.
# AI_ROUTING_PROVIDER=off skips the extra request. Other options:
# typesafe: Jev with TYPESAFE_AI_API_KEY; openai: Decisions with OPENAI_API_KEY;
# anthropic: Haiku classification with ANTHROPIC_API_KEY.
# AI_ROUTING_MODEL_ID= (defaults: provider-specific Jev ID, gpt-6-luna, or claude-haiku-5-5)
# AI_ROUTING_MIN_PROBABILITY=0.95 (starting threshold, not measured accuracy)
# Optional cheaper routine reply model; no extra model is forced.
# Requires a native probability distribution (Jev or OpenAI Decisions), not Haiku classification.
# AI_ROUTINE_MODEL_ID=
# AI_ROUTINE_PROVIDER= (defaults to AI_PROVIDER)
# TYPESAFE_AI_API_KEY=
# Only keys for enabled reply, decision and routine providers are read:
# AI_GATEWAY_API_KEY=   (on Vercel, the deployment's OIDC token works instead)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional dollar budget for this installation's AI key, for a public demo or a
# shared key. Spend adds up; when it reaches the budget, the shop keeps selling
# without the assistant until you raise it. Unset: no dollar limit.
# AI_BUDGET_USD=100
# Price for a model the built-in table does not list, "input,output" US dollars per
# million tokens. Built in: Claude Opus, Sonnet and Haiku 5.5, gpt-6-luna, gpt-5-mini.
# AI_PRICE_PER_MILLION_TOKENS=2,10

# A public demo of Seller Desk itself. The home address shows the Seller Desk home page
# instead of the shop, search engines may index it, and the banner links to it.
# Leave unset for a real shop.
# PUBLIC_DEMO=true

# PayPal sandbox app (sandbox mode only): developer.paypal.com > Apps & Credentials > Sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MERCHANT_ID=   the sandbox business account's merchant ID (payee check)
# PAYPAL_WEBHOOK_ID=    the webhook you create for APP_URL/api/paypal/webhook

# Optional existing WooCommerce catalog. Use the WordPress installation's public
# HTTPS URL (including its subdirectory, if any). No admin key is needed.
# Only the deployment operator controls this outbound destination. This is not
# a user/model URL input. Local HTTP is allowed only in fixture mode.
# WOO_STORE_URL=https://shop.example.com
